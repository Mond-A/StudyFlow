# ── StudyFlow 基础配置 ─────────────────────────────────────────────
# 复制为 .env 后按需修改。.env 不应提交到版本库。
FLASK_ENV=production
HOST=127.0.0.1
PORT=5000

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required for startup validation and legacy single-user database compatibility.
# Generate with: python scripts/hash_password.py
# New users register with email; this hash is not their normal login credential.
STUDYFLOW_PASSWORD_HASH=

# Session / login protection
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Email accounts and verification. console is for local development only; it
# records the verification URL locally and does NOT send a real email.
# Production must use smtp and fill SMTP_HOST plus credentials.
# PUBLIC_BASE_URL is embedded in the verification link.
MAIL_BACKEND=console
MAIL_FROM=StudyFlow <no-reply@example.com>
PUBLIC_BASE_URL=http://127.0.0.1:5000
EMAIL_VERIFICATION_HOURS=24
PASSWORD_MIN_LENGTH=12
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Set true only when Flask is behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host.
TRUST_PROXY=false

TIMEZONE=Asia/Shanghai

# 相对路径以项目根目录为基准
DATABASE_PATH=data/studyflow.db
UPLOAD_DIR=data/uploads

# Production default: do not seed demo records into the live database.
SEED_DEMO=false

# 允许跨域访问 API 的前端地址，多个用英文逗号分隔；留空表示仅同源访问
CORS_ORIGINS=

# ── AI 配置 ─────────────────────────────────────────────────────────
# auto : 配置了对应密钥时调用真实模型，未配置时进入演示模式（响应会明确标记）
# on   : 始终使用演示模式（不发起外部请求）
# off  : 严格模式，未配置密钥时 API 返回 AI_NOT_CONFIGURED 错误
AI_DEMO_MODE=auto
AI_TIMEOUT=60
AI_MAX_RETRIES=2

# 文本模型（推荐 DeepSeek，任何 OpenAI 兼容接口均可）
# 官方申请：https://platform.deepseek.com/
AI_TEXT_PROVIDER=deepseek
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_MODEL=deepseek-chat

# 视觉模型：阿里云百炼 DashScope OpenAI 兼容模式
# 官方申请：https://bailian.console.aliyun.com/
# Base URL 必须由环境变量提供，后端代码中不再硬编码默认地址。
# 图片会以 data URL + image_url 多模态消息发送给模型，不会把本地路径当文本发送。
AI_VISION_PROVIDER=qwen
AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_MODEL=qwen3.8-flash
