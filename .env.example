# ── StudyFlow 基础配置 ─────────────────────────────────────────────
# 复制为 .env 后按需修改。.env 不应提交到版本库。
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=please-change-this-to-a-random-string
TIMEZONE=Asia/Shanghai

# 相对路径以项目根目录为基准
DATABASE_PATH=data/studyflow.db
UPLOAD_DIR=data/uploads

# 首次初始化数据库时写入少量演示数据（可在设置页清除）
SEED_DEMO=true

# 允许跨域访问 API 的前端地址，多个用英文逗号分隔；留空表示仅同源访问
CORS_ORIGINS=

# ── AI 配置 ─────────────────────────────────────────────────────────
# auto : 配置了对应密钥时调用真实模型，未配置时进入演示模式（响应会明确标记）
# on   : 始终使用演示模式（不发起外部请求）
# off  : 严格模式，未配置密钥时 API 返回 AI_NOT_CONFIGURED 错误
AI_DEMO_MODE=auto
AI_TIMEOUT=60
AI_MAX_RETRIES=2

# 文本模型（推荐 DeepSeek，任何 OpenAI 兼容接口均可）
# 官方申请：https://platform.deepseek.com/
AI_TEXT_PROVIDER=deepseek
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=https://api.deepseek.com/v1
AI_TEXT_MODEL=deepseek-chat

# 视觉模型（推荐阿里云百炼 Qwen-VL，OpenAI 兼容模式）
# 官方申请：https://bailian.console.aliyun.com/
AI_VISION_PROVIDER=qwen
AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_MODEL=qwen-vl-max
